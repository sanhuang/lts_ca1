# Vue 3 地圖前端 — multi-stage：build dist → nginx
# build context: 專案根目錄
# docker build -f docker/Dockerfile.vue3 -t lts-map .

# ----- build -----
FROM node:20-alpine AS build

WORKDIR /app

COPY Frontend/package.json ./
RUN npm install

COPY Frontend/ ./

# 瀏覽器連 Backend WS（compose 預設走主機映射 8000）
ARG VITE_WS_URL=ws://localhost:8000/ws
ARG VITE_APP_ORIGIN=http://localhost:8080
ARG VITE_INIT_LAT=
ARG VITE_INIT_LON=
ARG VITE_INIT_ZOOM=16
ENV VITE_WS_URL=$VITE_WS_URL \
    VITE_APP_ORIGIN=$VITE_APP_ORIGIN \
    VITE_INIT_LAT=$VITE_INIT_LAT \
    VITE_INIT_LON=$VITE_INIT_LON \
    VITE_INIT_ZOOM=$VITE_INIT_ZOOM

RUN npm run build

# ----- runtime -----
FROM nginx:1.27-alpine

COPY docker/nginx-vue3.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
